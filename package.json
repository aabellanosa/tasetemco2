{
  "name": "tasetemco",
  "version": "0.1.0",
  "private": true,
  "description": "ACME Cooperative generic demo application.",
  "workspaces": [
    "frontend",
    "backend"
  ],
  "scripts": {
    "dev:frontend": "npm --prefix frontend run dev",
    "dev:backend": "npm --prefix backend run dev",
    "build": "npm --prefix frontend run build",
    "start": "npm --prefix backend start",
    "render:predeploy": "npm run pg:schema",
    "render:seed": "npm run pg:seed",
    "pg:migrate": "npm run pg:schema",
    "pg:schema": "node scripts/pg-maintenance.js schema",
    "pg:seed": "node scripts/pg-maintenance.js seed",
    "pg:seed-loan-products": "node scripts/pg-maintenance.js seed-loan-products",
    "pg:backup": "node scripts/pg-maintenance.js backup",
    "pg:reset-demo": "node scripts/pg-maintenance.js reset-demo",
    "test": "node scripts/smoke-spike.js",
    "smoke": "node scripts/smoke-spike.js",
    "smoke:postgres": "node scripts/smoke-postgres.js",
    "check": "node --check backend/src/server.js && node --check backend/src/data.js && node --check scripts/smoke-spike.js && node --check scripts/smoke-postgres.js && node --check scripts/pg-maintenance.js && npm --prefix frontend run check"
  },
  "engines": {
    "node": ">=22.5.0"
  }
}
