HOST=127.0.0.1
PORT=4000

# Leave DB_HOST blank to run the current backend with in-memory seed data.
DB_HOST=
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=tasetemco_spike

# Postgres pivot tooling. These are used by npm run pg:* scripts.
# Prefer DATABASE_URL because Render provides it directly.
DATABASE_URL=postgres://postgres:yourpassword@127.0.0.1:5432/tasetemco_spike
# PGSSLMODE=require

# Discrete Postgres settings may be used instead of DATABASE_URL.
# PGHOST=127.0.0.1
# PGPORT=5432
# PGUSER=postgres
# PGPASSWORD=yourpassword
# PGDATABASE=tasetemco_spike
