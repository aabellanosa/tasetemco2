HOST=127.0.0.1
PORT=4000

# Leave DATABASE_URL blank to run the backend with in-memory seed data.
# Prefer DATABASE_URL because Render provides it directly.
DATABASE_URL=postgres://postgres:yourpassword@127.0.0.1:5432/tasetemco_spike
# PGSSLMODE=require

# Discrete Postgres settings may be used instead of DATABASE_URL.
# PGHOST=127.0.0.1
# PGPORT=5432
# PGUSER=postgres
# PGPASSWORD=yourpassword
# PGDATABASE=tasetemco_spike
# Destructive demo resets require a disposable database ending in _test, _smoke,
# or _demo and an exact token such as: ALLOW_DEMO_DATABASE_RESET=RESET tasetemco_smoke
ALLOW_DEMO_DATABASE_RESET=
